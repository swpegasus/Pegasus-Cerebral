<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.3.0</Version>
    <Description>Native interactive Help workflow and reference map for Cerebral</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(CerebralSdkDirectory)' == ''">
    <ProjectReference Include="../../src/Cerebral.Desktop.Plugins/Cerebral.Desktop.Plugins.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(CerebralSdkDirectory)' != ''">
    <Reference Include="Cerebral.Desktop.Plugins">
      <HintPath>$(CerebralSdkDirectory)/Cerebral.Desktop.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyDesktopPluginManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/desktop-plugin.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
