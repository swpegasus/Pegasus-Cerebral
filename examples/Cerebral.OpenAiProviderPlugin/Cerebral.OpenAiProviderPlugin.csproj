<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <CerebralSdkDirectory Condition="'$(CerebralSdkDirectory)' == ''">../../src/Cerebral.Orchestrator/bin/Release/net10.0-windows</CerebralSdkDirectory>
    <Description>Optional OpenAI hosted model adapter; no ambient credentials or default account activation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Cerebral.Core"><HintPath>$(CerebralSdkDirectory)/Cerebral.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cerebral.Contracts"><HintPath>$(CerebralSdkDirectory)/Cerebral.Contracts.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../Cerebral.HostedProviderProtocol/*.cs" Link="Protocol/%(Filename)%(Extension)" />
    <None Update="service-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
