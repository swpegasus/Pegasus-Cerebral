<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../assets/branding/cerebral-worker.ico</ApplicationIcon>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><UseAppHost>true</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Private CPU speech helper for AI Dictation; no desktop control, listener or service.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Cerebral.AiDictationPlugin/NemoNativeAsr.cs" Link="NemoNativeAsr.cs" />
    <Compile Include="../Cerebral.AiDictationPlugin/DictationNativeProtocol.cs" Link="DictationNativeProtocol.cs" />
  </ItemGroup>
</Project>
