<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Versioned public native desktop plugin API for Pegasus Cerebral</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/icons/chat-v1/index.ini" LogicalName="Cerebral.Desktop.Plugins.ChatIcons.index.ini" />
    <Content Include="../../assets/icons/chat-v1/**/*" Link="Resources/Icons/chat-v1/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
