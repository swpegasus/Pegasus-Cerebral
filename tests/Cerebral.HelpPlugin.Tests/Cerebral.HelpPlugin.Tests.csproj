<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HelpPluginDirectory Condition="'$(HelpPluginDirectory)' == ''">$(MSBuildProjectDirectory)/../../build/Help/plugin</HelpPluginDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Cerebral.HelpPlugin"><HintPath>$(HelpPluginDirectory)/Cerebral.HelpPlugin.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Cerebral.Desktop.Plugins"><HintPath>$(CerebralSdkDirectory)/Cerebral.Desktop.Plugins.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireReviewedSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CerebralSdkDirectory)' == ''" Text="Pass CerebralSdkDirectory for the reviewed desktop SDK used to build Help." />
  </Target>
</Project>
